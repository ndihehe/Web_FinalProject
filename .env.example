# Database Configuration (PostgreSQL / Neon Cloud)
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Authentication / Security
JWT_SECRET=your_jwt_secret_key_at_least_256_bits

# Frontend API Base URL (Proxy qua Vite sang Tomcat cổng 8080)
VITE_API_BASE_URL=/cinema/api

# Frontend API Mode:
# Đặt 'false' để kết nối API thật từ Tomcat và CSDL PostgreSQL Neon (không dùng mock)
# Đặt 'true' để dùng mock data offline
VITE_USE_MOCK=false

# TMDB API (The Movie Database) - Tự động tìm kiếm trailer chính thức cho mọi phim
# Đăng ký miễn phí tại: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
