# Database Configuration (PostgreSQL / Neon Cloud)
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Authentication / Security
JWT_SECRET=your_jwt_secret_key_at_least_256_bits

# Frontend API Base URL (Java Servlet backend endpoint)
VITE_API_BASE_URL=http://localhost:8080/Cinema_war_exploded/api/v1

# Frontend API Mode:
# Set to 'false' to connect to the real Java Servlet API (zero mock/test data returned)
# Set to 'true' (or omit) to run the in-memory offline development engine
VITE_USE_MOCK=false
